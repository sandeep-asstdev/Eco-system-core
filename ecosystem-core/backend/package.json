{
  "name": "ecosystem-core-api",
  "version": "1.0.0",
  "description": "Central Governance API for Multi-Tenant Automobile Dealership Ecosystem",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "postinstall": "npm --prefix ../../packages/ecosystem-sdk install --omit=dev 2>/dev/null || true",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "node tests/core.test.js && node tests/phase3.test.js && node tests/keycloak.test.js && node tests/portal-integration.test.js && node tests/formContractResilience.test.js"
  },
  "dependencies": {
    "@automobile-ecosystem/sdk": "file:../../packages/ecosystem-sdk",
    "@prisma/client": "^5.22.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
