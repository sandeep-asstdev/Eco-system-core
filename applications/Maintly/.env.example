# ==========================================
# MAINTLY Environment Variables
# ==========================================

# Backend API Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL 18 Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/maintly_db?schema=public

# Security & Tokens
JWT_SECRET=maintly_enterprise_secure_token_secret_key_2026
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
