# HRFlow Backend Environment Configuration
PORT=5000

# PostgreSQL Connection String (Default uses port 5433 for PostgreSQL 18)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hrflow_db?schema=public"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"
JWT_EXPIRES_IN="7d"

# Frontend Application Origin
CLIENT_URL="http://localhost:5173"
