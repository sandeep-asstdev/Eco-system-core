# ========================================================
# Ecosystem Core Environment Variables Template
# ========================================================

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL 18 Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecosystem_core_db?schema=public

# Security & Fallback JWT Secret
JWT_SECRET=ecosystem_core_master_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Keycloak OIDC Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=automobile-ecosystem
KEYCLOAK_CLIENT_ID=ecosystem-core-api
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/automobile-ecosystem/protocol/openid-connect/certs

# Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379
